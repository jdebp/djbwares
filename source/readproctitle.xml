<refentry id="readproctitle">

<refmeta xmlns:xi="http://www.w3.org/2001/XInclude">
<refentrytitle>readproctitle</refentrytitle>
<manvolnum>1</manvolnum>
<refmiscinfo class="manual">user commands</refmiscinfo>
